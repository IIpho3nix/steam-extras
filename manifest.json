{
  "manifest_version": 3,
  "name": "Steam Extras",
  "version": "1.0.0",
  "description": "Adds extra features to the Steam website",
  "icons": {
    "48": "icons/icon_48.png",
    "96": "icons/icon_96.png"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*.steampowered.com/*",
    "*://*.steamcommunity.com/*",
    "*://steampowered.com/*",
    "*://steamcommunity.com/*",
    "*://www.protondb.com/*",
    "*://api.isthereanydeal.com/*"
  ],
  "options_ui": {
    "page": "html/options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.steampowered.com/*",
        "*://*.steamcommunity.com/*",
        "*://steampowered.com/*",
        "*://steamcommunity.com/*"
      ],
      "js": ["js/steam.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "js/background.js"
  },  
  "applications": {
    "gecko": {
      "id": "steam-extras@iipho3nix.me"
    }
  },
  "action": {
    "default_icon": {
      "48": "icons/icon_48.png",
      "96": "icons/icon_96.png"
    },
    "default_title": "Steam Extras"
  }
}
